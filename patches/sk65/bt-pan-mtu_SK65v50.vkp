; SK65sw50 (SGOLD) Bluetooth PAN MTU 1500 for bt-pan_SG: L2CAP limit 1696, BNEP MTU 1691.
; EXPERIMENTAL, untested on the phone. Apply only to SK65v50. Generated by port-mtu-sk65.py.
;
; The S65v58 patch (bt-pan-mtu_S65v58.vkp) at SK65v50 addresses: stock RX/TX ACL pool counts,
; bigger objects, all 0x14F..0x158 limits on the RX/TX data path raised, PB=0 accepted.
; Affects every BT profile; Java L2CAP apps can now negotiate MTU above 335.
; Writes no free flash (no stub).

; BT_RX_ACL_HEAP object_size: 0x1B4 -> 0x704, count stays 0x1A (descriptor A0095D3C).
;   26 * 0x1C0 = 0x2D80 -> 26 * 0x710 = 0xB7A0 (+0x8A20)
0x00095D48: B4010000 04070000

; BT_TX_ACL_HEAP object_size: 0x174 -> 0x704, count stays 0x24 (descriptor A0095D10).
;   36 * 0x180 = 0x3600 -> 36 * 0x710 = 0xFE40 (+0xC840). RX+TX: +0x15260 (84.6 KiB RAM)
0x00095D1C: 74010000 04070000

; RX ACL block request (S65 A0B3F9B6): 0x1A0 -> 0x6F0. Data starts 48 bytes into the block,
; so an RX block now holds 0x6C0 bytes (L2CAP SDU 0x6A0 + header, reassembled in place).
0x006FB58E: FF21A131 DE21C900

; TX ACL block request (S65 A0B3FA48): 0x160 -> 0x6F0. BTLP copies a whole SDU to +0x10.
0x006FB620: FF216131 DE21C900

; Transport callback GetDataSizeRxAcl (S65 A0B34226): 0x158 -> 0x6A8.
0x006E5A92: FF205930 D520C000

; Incoming HCI ACL payload limit (S65 A0B7E9C6): 0x14F -> 0x6A0.
0x0074C5CE: FF225032 D422D200

; BTLSAR continuation append limit (S65 A0B7E560): 0x154 -> 0x6A0.
0x0074C168: FF255535 D425ED00

; LDAEstReq outgoing connection (S65 A0B3E2BC): rx/tx MTU 48..0x14F -> 48..0x6A0.
; bt-pan_SG tests this word to see whether the patch is installed.
0x006F9E94: FF275037 D427FF00

; Server registration (S65 A0B3E55A): the same MTU check, 0x14F -> 0x6A0.
0x006FA132: FF275037 D427FF00

; BTLP_uiSendDataOverBT chunk (S65 A0B44204): 0x14F -> 0x6A0, one SDU per call.
0x006FFDDC: FF265036 D426F600

; BTLSAR: accept HCI PB=0 (Linux non-flushable start) as a first fragment, in place:
; lsls r0,#18; lsrs r1,r0,#30; cmp r1,#2  ->  lsls r0,#19; lsrs r1,r0,#31; cmp r1,#0
0x0074C0DA: 8004810F0229 C004C10F0029
