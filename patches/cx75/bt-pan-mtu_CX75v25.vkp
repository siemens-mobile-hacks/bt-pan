; CX75sw25 (SGOLD) Bluetooth PAN MTU 1500 for bt-pan_SG: L2CAP limit 1696, BNEP MTU 1691.
; EXPERIMENTAL, untested on the phone. Apply only to CX75v25. Generated by port-mtu-cx75.py.
;
; Port of bt-pan-mtu_S65v58.vkp: stock RX/TX ACL pool counts, bigger objects, all 0x14F..0x158
; limits on the RX/TX data path raised, HCI PB=0 accepted. Affects every BT profile.
; The stub uses A01FC000..A01FC00F (free in a stock CX75v25; check that no
; installed patch or language pack uses it).

; BT_RX_ACL_HEAP object_size: 0x1B4 -> 0x704, count stays 0x1A (descriptor A0096A48,
; S65 A0096080). 26 * 0x1C0 = 0x2D80 -> 26 * 0x710 = 0xB7A0 (+0x8A20)
0x00096A54: B4010000 04070000

; BT_TX_ACL_HEAP object_size: 0x174 -> 0x704, count stays 0x24 (descriptor A0096A1C).
;   36 * 0x180 = 0x3600 -> 36 * 0x710 = 0xFE40 (+0xC840). RX+TX: +0x15260 (84.6 KiB RAM)
0x00096A28: 74010000 04070000

; Boot memory (A097A50C): reserve of the permanent pool IMPERMEM (A8000000..A847A120) kept
; for permanent allocations after IMSYSMEM is carved: mov r0,#0xE8000 -> #0x100000 (+96 KiB;
; IMSYSMEM 0x36D894 -> 0x355894, ~1.7 MB of it free after boot). Stock leaves 0xABA0 free: the
; bigger ACL pools above made a later 0x1D4C0 alloc fail (error 0x66, then NULL write at
; A0202FA8 = no boot). S65v58 keeps 0x280000 here (A12C50EC). Emulator: boots, 0xD940 left.
0x0097A51C: E80AA0E3 0106A0E3

; RX ACL block request (A04FC748, S65 A0B3F996): 0x1A0 -> 0x6F0.
0x004FC782: FF21A131 DE21C900

; TX ACL block request (S65 A0B3FA14): 0x160 -> 0x6F0.
0x004FC814: FF216131 DE21C900

; Transport callback GetDataSizeRxAcl: 0x158 -> 0x6A8 (S65 A0B34226).
0x004EDF7E: FF205930 D520C000

; Incoming HCI ACL payload limit (A0548F66, S65 A0B7E9BA): 0x14F -> 0x6A0.
0x00548F72: FF225032 D422D200

; BTLSAR, CX75 only: SDU of CID 1 over 0x154 is counted and dropped; 0x154 -> 0x6A0 so it
; keeps matching the limit below.
0x00548AE0: FF265536 D426F600

; BTLSAR continuation append limit (S65 A0B7E560, r5 there): 0x154 -> 0x6A0.
0x00548B0E: FF265536 D426F600

; LDAEstReq (A04FB038, S65 A0B3E282) outgoing connection: rx/tx MTU 48..0x14F -> 48..0x6A0.
; bt-pan_SG reads this word to see whether the patch is installed.
0x004FB070: FF275037 D427FF00

; Server registration (A04FB2AC, S65 A0B3E4FA): the same MTU check, 0x14F -> 0x6A0.
0x004FB30C: FF275037 D427FF00

; BTLP_uiSendDataOverBT (A0500FCA, S65 A0B441C6) chunk: 0x14F -> 0x6A0, one SDU per call.
0x00501008: FF265036 D426F600

; Accept HCI PB=0 (Linux non-flushable start) as a first fragment: BTLSAR takes only PB=2.
; BL to the stub, which maps PB=0 to 2 and redoes the cmp and the ldr.
0x00548A56: 02295F48 B3F4D3FA

; Thumb stub: cmp r1,#0; bne; movs r1,#2; cmp r1,#2; ldr r0,=0xA8528DBC; bx lr
